<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Intelligence Report — {{ client_name }}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem;
            color: #1e293b;
            line-height: 1.6;
        }
        header {
            border-bottom: 2px solid #2563eb;
            padding-bottom: 1rem;
            margin-bottom: 2rem;
        }
        h1 { color: #1e40af; margin-bottom: 0.25rem; }
        .meta { color: #64748b; font-size: 0.875rem; }
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0;
        }
        .metric-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1rem;
            text-align: center;
        }
        .metric-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: #2563eb;
        }
        .metric-label {
            font-size: 0.8rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .chart-container { margin: 2rem 0; text-align: center; }
        .chart-container img { max-width: 100%; height: auto; border-radius: 4px; }
        .narrative { margin: 2rem 0; }
        footer {
            margin-top: 3rem;
            padding-top: 1rem;
            border-top: 1px solid #e2e8f0;
            font-size: 0.75rem;
            color: #94a3b8;
        }
    </style>
</head>
<body>
    <header>
        <h1>Workforce Intelligence Report</h1>
        <p class="meta">
            Client: <strong>{{ client_name }}</strong> |
            Run ID: <code>{{ run_id }}</code> |
            Generated: {{ created_at }}
        </p>
    </header>

    <section class="metrics-grid">
        <div class="metric-card">
            <div class="metric-value">{{ metrics.total_headcount }}</div>
            <div class="metric-label">Total Headcount</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ metrics.department_count }}</div>
            <div class="metric-label">Departments</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ "%.1f"|format(metrics.avg_tenure_years) }}</div>
            <div class="metric-label">Avg Tenure (yrs)</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ "%.1f"|format(metrics.turnover_risk_high_pct) }}%</div>
            <div class="metric-label">High Turnover Risk</div>
        </div>
    </section>

    <section class="chart-container">
        <img src="data:image/png;base64,{{ chart_b64 }}" alt="Headcount by Department">
    </section>

    <section class="narrative">
        <h2>Analysis</h2>
        <p>{{ narrative }}</p>
    </section>

    <footer>
        <p>
            Methodology version: {{ methodology_version }} |
            Code version: {{ code_version }} |
            Model: {{ model_id }} |
            This report was generated by the Intelligence Engine.
        </p>
    </footer>
</body>
</html>
